# 统一文本文件行尾，避免跨平台协作时行尾混乱
* text=auto

# 源码与配置明确按文本处理
*.cs text diff=csharp
*.json text
*.md text
*.txt text
*.shader text
*.xml text
*.yml text
*.yaml text
*.editorconfig text

# Unity 资产(YAML 文本)统一 LF 入库
*.meta text
*.asset text
*.unity text
*.prefab text
*.mat text
*.anim text
*.controller text

# 二进制资源不做任何转换
*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.psd binary
*.fbx binary
*.dll binary
*.exe binary
*.apk binary
*.ipa binary
*.unitypackage binary
*.ab binary
*.fontbinary binary
